# GOrchestrator Configuration

# LLM API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Service Endpoints
GBRAIN_ENDPOINT=http://localhost:3000
GSTACK_ENDPOINT=http://localhost:3001
GMIRROR_ENDPOINT=http://localhost:3002
GTOM_ENDPOINT=http://localhost:3003

# Sandbox Settings
SANDBOX_BACKEND=docker
MAX_CONCURRENCY=5

# Sampling Settings
DEFAULT_N=3
EXPLOIT_RATIO=0.3
PERTURB_RATIO=0.3
EXPLORE_RATIO=0.4

# Budget Limits
MAX_COST_USD=10.0
MAX_WALL_TIME_MS=300000
MAX_ATTEMPTS=10

# Mock Mode (for testing)
MOCK_SANDBOX=0

# Logging
LOG_LEVEL=info
